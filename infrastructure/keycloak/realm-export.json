{
  "realm": "cyberlab",
  "enabled": true,
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "sslRequired": "none",
  "accessTokenLifespan": 600,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "defaultRole": {
    "name": "default-roles-cyberlab",
    "description": "${role_default-roles}",
    "composite": true
  },
  "roles": {
      "realm": [
        { "name": "sysadmin", "description": "Full platform administration" },
        { "name": "faculty", "description": "Challenge authoring and analytics" },
        { "name": "competition_organizer", "description": "Manage competitions, teams, scoring" },
        { "name": "lab_admin", "description": "Manage environments, templates, resources" },
        { "name": "researcher", "description": "Access approved research analytics" },
        { "name": "student", "description": "Solve challenges and launch labs" },
        {
          "name": "default-roles-cyberlab",
          "description": "${role_default-roles}",
          "composite": true,
          "composites": {
            "realm": ["student"]
          }
        }
      ]
    },
  "clients": [
    {
      "clientId": "web",
      "name": "CyberLab Web",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"]
    },
    {
      "clientId": "api",
      "name": "CyberLab API",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "secret": "dev-secret-change-me",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:8000/*"],
      "webOrigins": ["http://localhost:8000"]
    }
  ],
  "users": [
    {
      "username": "admin",
      "email": "admin@cyberlab.local",
      "firstName": "System",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "admin", "temporary": false }],
      "realmRoles": ["sysadmin", "faculty"]
    },
    {
      "username": "faculty",
      "email": "faculty@cyberlab.local",
      "firstName": "Faculty",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "faculty", "temporary": false }],
      "realmRoles": ["faculty"]
    },
    {
      "username": "labadmin",
      "email": "labadmin@cyberlab.local",
      "firstName": "Lab",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "labadmin", "temporary": false }],
      "realmRoles": ["lab_admin"]
    },
    {
      "username": "student",
      "email": "student@cyberlab.local",
      "firstName": "Student",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "student", "temporary": false }],
      "realmRoles": ["student"]
    }
  ]
}