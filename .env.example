# IIC CyberLab — environment configuration
# Copy to .env and adjust. Never commit real secrets.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://cyberlab:cyberlab@localhost:5432/cyberlab
POSTGRES_USER=cyberlab
POSTGRES_PASSWORD=cyberlab

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Keycloak / OIDC ---
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
OIDC_ISSUER_URL=http://localhost:8080/realms/cyberlab
OIDC_WELL_KNOWN_URL=http://keycloak:8080/realms/cyberlab/.well-known/openid-configuration
OIDC_CLIENT_ID=api
OIDC_CLIENT_SECRET=dev-secret-change-me
WEB_CLIENT_ID=web

# --- App ---
APP_SECRET=dev-only-change-me
CORS_ORIGINS=http://localhost:3000

# --- Lab infrastructure (Phase 2+) ---
DOCKER_HOST=unix:///var/run/docker.sock
LABS_NETWORK_NAME=cyberlab_labs
LAB_DEFAULT_EXPIRY_MINUTES=60

# --- Research platform (Phase 6) ---
# Where pseudonymized research dataset artifacts are written (mounted in compose).
RESEARCH_DATA_DIR=data/research