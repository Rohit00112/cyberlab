# IIC CyberLab — production deployment env
# Copy to .env on the production host and fill REAL secrets. Never commit this.
# verify_config.py refuses to boot with placeholder values.

# --- Environment ---
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<db-host>:5432/cyberlab
POSTGRES_USER=<user>
POSTGRES_PASSWORD=<password>

# --- Redis ---
REDIS_URL=redis://<redis-host>:6379/0

# --- Keycloak / OIDC ---
# Keycloak runs in production mode behind TLS; use the public HTTPS issuer URL.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=<strong-admin-password>
OIDC_ISSUER_URL=https://auth.example.org/realms/cyberlab
OIDC_WELL_KNOWN_URL=https://auth.example.org/realms/cyberlab/.well-known/openid-configuration
OIDC_CLIENT_ID=api
OIDC_CLIENT_SECRET=<keycloak-api-client-secret>
WEB_CLIENT_ID=web

# --- App ---
APP_SECRET=<32+ random bytes, base64>
CORS_ORIGINS=https://cyberlab.example.org
# Secret used to verify signed cookies/JWTs if any; keep it rotated.

# --- Lab infrastructure ---
LAB_DOCKER_SOCKET=unix:///var/run/docker.sock
LABS_NETWORK_NAME=cyberlab_labs
LAB_DEFAULT_EXPIRY_MINUTES=60
LAB_MAX_EXPIRY_MINUTES=240
LAB_MAX_INSTANCES_PER_USER=2
LAB_PROVISIONING_TIMEOUT_MINUTES=10
LAB_CPU_LIMIT=1.0
LAB_MEMORY_LIMIT_MB=512
LAB_PIDS_LIMIT=256

# --- Research platform ---
RESEARCH_DATA_DIR=/app/data/research
RESEARCH_DATASET_EXPIRY_DAYS=30